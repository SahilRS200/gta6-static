{
  "name": "gta6-countdown",
  "version": "1.0.0",
  "private": true,
  "description": "GTA6Info.in — GTA 6 news, guides and fixes for players in India. Zero-dependency Node server.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "x:secrets": "node dev-tools/set-x-secrets.mjs",
    "x:posting:on": "node dev-tools/set-x-secrets.mjs --posting on",
    "x:posting:off": "node dev-tools/set-x-secrets.mjs --posting off"
  }
}
